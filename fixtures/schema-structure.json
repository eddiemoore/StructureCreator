  {
    "name": "repeat with literal count emits N files",
    "tree": {
      "root": {
        "type": "folder",
        "name": "root",
        "children": [
          {
            "type": "repeat",
            "name": "",
            "repeat_count": "3",
            "repeat_as": "i",
            "children": [{ "type": "file", "name": "item-%i%.txt" }]
          }
        ]
      },
      "stats": { "folders": 0, "files": 0, "downloads": 0, "generated": 0 }
    },
    "variables": {},
    "expectedPaths": [
      "root",
